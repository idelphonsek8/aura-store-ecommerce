DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For Postgres in production, uncomment and set:
# DATABASE_URL=postgres://user:password@localhost:5432/aura_commerce

# Cloudinary (product image storage) - required even in local dev, see Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry (production error tracking) - optional in local dev, only active when DJANGO_DEBUG=False
SENTRY_DSN=